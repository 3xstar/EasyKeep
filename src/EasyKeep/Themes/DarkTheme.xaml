<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Тёмная тема: «Ночной бассейн с ледяными лампами
         (Night Poolrooms)».
         Ночной пустой зал с тёмной глубокой сине-графитовой плиткой,
         тёмной водой и яркими вертикальными ледяными
         люминесцентными светильниками. Только палитра, градиенты
         и векторные кисти — без растровых эффектов и привязок
         внутри кистей.
         ============================================================ -->

    <!-- ============================================================
         ФОН ОКНА: один кэшированный тайл 24×24 px.
         Тонкая ледяная сетка швов #1838BDF8 — слабый холодный
         отблеск на влажном кафеле.
         ============================================================ -->
    <DrawingBrush x:Key="BackgroundTileBrush"
                  Viewbox="0,0,24,24"
                  ViewboxUnits="Absolute"
                  Viewport="0,0,24,24"
                  ViewportUnits="Absolute"
                  TileMode="Tile"
                  Stretch="Fill"
                  RenderOptions.CachingHint="Cache">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,24,24" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#1838BDF8" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0.5" EndPoint="24,0.5" />
                            <LineGeometry StartPoint="0.5,0" EndPoint="0.5,24" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Фон окна: глубокий ночной океанически-графитовый градиент
         #0A1524 сверху → #04080F снизу и ледяная сетка швов. -->
    <DrawingBrush x:Key="WindowBackgroundBrush"
                  Viewbox="0,0,4096,4096"
                  ViewboxUnits="Absolute"
                  Viewport="0,0,4096,4096"
                  ViewportUnits="Absolute"
                  TileMode="Tile"
                  Stretch="Fill"
                  AlignmentX="Left"
                  AlignmentY="Top">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#04080F">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,4096,4096" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="0,1080"
                                             MappingMode="Absolute">
                            <GradientStop Color="#0A1524" Offset="0" />
                            <GradientStop Color="#04080F" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1920,1080" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource BackgroundTileBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,4096,4096" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Совместимый ключ: все экраны и диалоги используют его. -->
    <StaticResource x:Key="AppBackgroundBrush" ResourceKey="WindowBackgroundBrush" />

    <!-- ============================================================
         Поверхности: тёмный мокрый кафель навигации, влажный сланец
         карточек и холодная металлическая обводка.
         ============================================================ -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#08111D" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#152A42" />
    <StaticResource x:Key="NavBackgroundBrush" ResourceKey="SidebarBackgroundBrush" />

    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0D1928" />
    <LinearGradientBrush x:Key="CardSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#132438" Offset="0" />
        <GradientStop Color="#0B1624" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1C3752" />
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#152B44" />
    <StaticResource x:Key="SurfaceRaisedBrush" ResourceKey="ElevatedSurfaceBrush" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#152B44" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#1F38BDF8" />
    <LinearGradientBrush x:Key="PopupBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#132438" Offset="0" />
        <GradientStop Color="#0B1624" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#07101A" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#1F3E5C" />
    <SolidColorBrush x:Key="DividerBrush" Color="#152A42" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2A4A66" />

    <!-- ============================================================
         Шапка таблиц: глубокая ночная вода с холодным нижним швом.
         ============================================================ -->
    <SolidColorBrush x:Key="TableHeaderBackgroundBrush" Color="#112236" />
    <SolidColorBrush x:Key="TableHeaderBorderBrush" Color="#204060" />
    <SolidColorBrush x:Key="TableHeaderForegroundBrush" Color="#CBE3F7" />

    <!-- ============================================================
         Акцент: яркий ледяной циан вертикальных ламп бассейна.
         ============================================================ -->
    <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F38BDF8" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#04101C" />
    <SolidColorBrush x:Key="FocusBrush" Color="#38BDF8" />

    <!-- Активная вкладка: ледяная подсветка и светящийся текст. -->
    <SolidColorBrush x:Key="NavActiveForegroundBrush" Color="#E0F2FE" />

    <!-- Вторичная кнопка: мокрый тёмный кафель под лампой. -->
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#102033" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#214261" />
    <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#D8EBF8" />

    <!-- ============================================================
         Текст: светящийся ледяной белый и приглушённые подписи.
         ============================================================ -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6F2FA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7E9BB5" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

    <!-- ============================================================
         Вывеска EasyKeep: светящаяся ледяная лампа ночного бассейна.
         ShadowDepth=0 — не тень, а источник света вокруг текста.
         ============================================================ -->
    <SolidColorBrush x:Key="BrandSignForegroundBrush" Color="#E0F2FE" />
    <DropShadowEffect x:Key="BrandSignEffect"
                      BlurRadius="12"
                      ShadowDepth="0"
                      Direction="270"
                      Opacity="0.85"
                      Color="#38BDF8" />

    <!-- ============================================================
         Логотип-ромб Night Poolrooms Dark: тёмный кафель бортика и
         светящаяся ледяная гладь воды.
         ============================================================ -->
    <SolidColorBrush x:Key="LogoRimBrush" Color="#0E1B2B" />
    <SolidColorBrush x:Key="LogoRimBorderBrush" Color="#234463" />
    <LinearGradientBrush x:Key="LogoWaterBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7DD3FC" Offset="0" />
        <GradientStop Color="#0EA5E9" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================================
         Светофор дефицита и служебные акценты.
         ============================================================ -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#2DD4BF" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="InfoBrush" Color="#22D3EE" />
    <SolidColorBrush x:Key="TextOnDangerBrush" Color="#1A0B0B" />

    <!-- ============================================================
         Бейджи: ледяные индикаторы на тёмном сланце.
         ============================================================ -->
    <SolidColorBrush x:Key="BadgeNeutralBackgroundBrush" Color="#152B44" />
    <SolidColorBrush x:Key="BadgeNeutralForegroundBrush" Color="#CBE3F7" />
    <SolidColorBrush x:Key="BadgeCriticalBackgroundBrush" Color="#2A1518" />
    <SolidColorBrush x:Key="BadgeCriticalForegroundBrush" Color="#F87171" />
    <SolidColorBrush x:Key="BadgeWarningBackgroundBrush" Color="#2A2110" />
    <SolidColorBrush x:Key="BadgeWarningForegroundBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="BadgeSuccessBackgroundBrush" Color="#0F2A28" />
    <SolidColorBrush x:Key="BadgeSuccessForegroundBrush" Color="#2DD4BF" />
    <SolidColorBrush x:Key="BadgeInfoBackgroundBrush" Color="#102A3A" />
    <SolidColorBrush x:Key="BadgeInfoForegroundBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="BadgeMutedBackgroundBrush" Color="#101B2A" />
    <SolidColorBrush x:Key="BadgeMutedForegroundBrush" Color="#64748B" />

    <!-- ============================================================
         Сегментированный переключатель темы.
         ============================================================ -->
    <SolidColorBrush x:Key="SegmentTrackBrush" Color="#102033" />
    <SolidColorBrush x:Key="SegmentThumbBrush" Color="#1C3752" />

    <!-- ============================================================
         Растровые эффекты отключены: глубину создают градиент,
         1-px металлическая обводка и ледяные акценты.
         Ключи сохранены для существующих DataTrigger'ов.
         ============================================================ -->
    <x:Null x:Key="GlowCriticalEffect" />
    <x:Null x:Key="GlowWarningEffect" />
    <x:Null x:Key="GlowSuccessEffect" />
    <x:Null x:Key="GlowMutedEffect" />
    <x:Null x:Key="CardShadowEffect" />
    <x:Null x:Key="PopupShadowEffect" />

</ResourceDictionary>
