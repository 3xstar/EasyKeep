<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Светлая тема: Poolrooms.
         Бесконечный плиточный бассейн, залитый мягким солнцем:
         молочная керамика, бирюзовая вода и тонкие швы плитки.
         Только палитра, градиенты и векторные кисти. Никаких
         растровых эффектов и привязок внутри кистей, поэтому
         все ресурсы остаются свободно замораживаемыми (Freezable),
         а переключение тем происходит мгновенно.
         ============================================================ -->

    <!-- ============================================================
         ФОН ОКНА: единый векторный слой.
         BackgroundTileBrush — один кэшированный тайл 28×28 px:
         тонкий шов цвета #123A4A44 (≈7 % прозрачности).
         Viewport фиксирован в абсолютных единицах, поэтому GPU
         рисует тайл один раз и мгновенно замостит фон при ресайзе.
         ============================================================ -->
    <DrawingBrush x:Key="BackgroundTileBrush"
                  Viewbox="0,0,28,28"
                  ViewboxUnits="Absolute"
                  Viewport="0,0,28,28"
                  ViewportUnits="Absolute"
                  TileMode="Tile"
                  Stretch="Fill"
                  RenderOptions.CachingHint="Cache">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,28,28" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#123A4A44" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0.5" EndPoint="28,0.5" />
                            <LineGeometry StartPoint="0.5,0" EndPoint="0.5,28" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Фон окна: тёплая керамика #F3F2EC с диагональным солнечным
         градиентом #F7F6F0 → #E7ECE8 и плиточным швом сверху.
         Базовый прямоугольник страхует область за пределами
         градиента, поэтому окно любого размера остаётся светлым. -->
    <DrawingBrush x:Key="WindowBackgroundBrush"
                  Viewbox="0,0,4096,4096"
                  ViewboxUnits="Absolute"
                  Viewport="0,0,4096,4096"
                  ViewportUnits="Absolute"
                  TileMode="Tile"
                  Stretch="Fill"
                  AlignmentX="Left"
                  AlignmentY="Top">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#E7ECE8">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,4096,4096" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1920,1080"
                                             MappingMode="Absolute">
                            <GradientStop Color="#F7F6F0" Offset="0" />
                            <GradientStop Color="#F3F2EC" Offset="0.52" />
                            <GradientStop Color="#E7ECE8" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1920,1080" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource BackgroundTileBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,4096,4096" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Совместимый ключ: все экраны и диалоги используют его. -->
    <StaticResource x:Key="AppBackgroundBrush" ResourceKey="WindowBackgroundBrush" />

    <!-- ============================================================
         Поверхности: слой 1 — плитка фона, слой 2 — фарфоровая
         карточка, слой 3 — подсвеченное мелководье.
         ============================================================ -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FCFBF7" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FCFBF7" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#D4DDD8" />
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#E6F4F1" />
    <StaticResource x:Key="SurfaceRaisedBrush" ResourceKey="ElevatedSurfaceBrush" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#EAF7F3" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#CCFBF1" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#F7F6F0" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FCFBF7" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#DCE5E0" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#A9C0BA" />

    <!-- ============================================================
         Акцент: прозрачная вода бассейна.
         ============================================================ -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0D9488" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0F766E" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#CCFBF1" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FocusBrush" Color="#0D9488" />

    <!-- ============================================================
         Текст: глубокий хвойный сланец вместо чистого чёрного.
         ============================================================ -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#162B29" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A706C" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

    <!-- ============================================================
         Вывеска EasyKeep: тёплый дневной блик и мягкая деликатная
         тень только у одного статичного маленького TextBlock.
         ============================================================ -->
    <SolidColorBrush x:Key="BrandSignForegroundBrush" Color="#122927" />
    <DropShadowEffect x:Key="BrandSignEffect"
                      BlurRadius="6"
                      ShadowDepth="2"
                      Direction="270"
                      Opacity="0.18"
                      Color="#163834" />

    <!-- ============================================================
         Светофор дефицита: бирюза, янтарь, терракота, серый.
         ============================================================ -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#0D9488" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0E7490" />
    <SolidColorBrush x:Key="TextOnDangerBrush" Color="#FFFFFF" />

    <!-- ============================================================
         Бейджи: мягкие керамические подложки.
         ============================================================ -->
    <SolidColorBrush x:Key="BadgeNeutralBackgroundBrush" Color="#EDF3F0" />
    <SolidColorBrush x:Key="BadgeNeutralForegroundBrush" Color="#455C58" />
    <SolidColorBrush x:Key="BadgeCriticalBackgroundBrush" Color="#FDEEED" />
    <SolidColorBrush x:Key="BadgeCriticalForegroundBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="BadgeWarningBackgroundBrush" Color="#FEF3E2" />
    <SolidColorBrush x:Key="BadgeWarningForegroundBrush" Color="#B45309" />
    <SolidColorBrush x:Key="BadgeSuccessBackgroundBrush" Color="#E3F7F2" />
    <SolidColorBrush x:Key="BadgeSuccessForegroundBrush" Color="#0F766E" />
    <SolidColorBrush x:Key="BadgeInfoBackgroundBrush" Color="#E0F2FE" />
    <SolidColorBrush x:Key="BadgeInfoForegroundBrush" Color="#0E7490" />
    <SolidColorBrush x:Key="BadgeMutedBackgroundBrush" Color="#F1F4F2" />
    <SolidColorBrush x:Key="BadgeMutedForegroundBrush" Color="#64748B" />

    <!-- ============================================================
         Сегментированный переключатель темы.
         ============================================================ -->
    <SolidColorBrush x:Key="SegmentTrackBrush" Color="#E8EFEA" />
    <SolidColorBrush x:Key="SegmentThumbBrush" Color="#FFFFFF" />

    <!-- ============================================================
         Растровые эффекты отключены: глубину дают 1-px обводки,
         фарфоровый градиент и плиточный шов. Ключи сохранены,
         чтобы существующие DataTrigger'ы продолжали работать.
         ============================================================ -->
    <x:Null x:Key="GlowCriticalEffect" />
    <x:Null x:Key="GlowWarningEffect" />
    <x:Null x:Key="GlowSuccessEffect" />
    <x:Null x:Key="GlowMutedEffect" />
    <x:Null x:Key="CardShadowEffect" />
    <x:Null x:Key="PopupShadowEffect" />

</ResourceDictionary>
