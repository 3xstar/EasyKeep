<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Светлая тема: холодный люминесцентный свет и светлый бетон.
         Только палитра и эффекты. Все элементы интерфейса берут
         цвета через DynamicResource, поэтому тема применяется
         мгновенно, без перезапуска окна.
         ============================================================ -->

    <!-- Поверхности -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F2F4F7" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" Opacity="0.85" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F7F9FC" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EDF0F5" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#CBD5E1" />

    <!-- Акцент -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Текст -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

    <!-- Светофор дефицита -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="InfoBrush" Color="#2563EB" />

    <!-- Бейджи -->
    <SolidColorBrush x:Key="BadgeNeutralBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="BadgeNeutralForegroundBrush" Color="#475569" />
    <SolidColorBrush x:Key="BadgeCriticalBackgroundBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="BadgeCriticalForegroundBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="BadgeWarningBackgroundBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="BadgeWarningForegroundBrush" Color="#B45309" />
    <SolidColorBrush x:Key="BadgeSuccessBackgroundBrush" Color="#F0FDF4" />
    <SolidColorBrush x:Key="BadgeSuccessForegroundBrush" Color="#15803D" />
    <SolidColorBrush x:Key="BadgeInfoBackgroundBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="BadgeInfoForegroundBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="BadgeMutedBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="BadgeMutedForegroundBrush" Color="#64748B" />

    <!-- Сегментированный переключатель темы -->
    <SolidColorBrush x:Key="SegmentTrackBrush" Color="#EEF1F6" />
    <SolidColorBrush x:Key="SegmentThumbBrush" Color="#FFFFFF" />

    <!-- Мягкое свечение индикаторов «Светофора»: в светлой теме отключено. -->
    <DropShadowEffect x:Key="GlowCriticalEffect" Color="#DC2626" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <DropShadowEffect x:Key="GlowWarningEffect" Color="#D97706" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <DropShadowEffect x:Key="GlowSuccessEffect" Color="#16A34A" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <DropShadowEffect x:Key="GlowMutedEffect" Color="#64748B" BlurRadius="0" ShadowDepth="0" Opacity="0" />

    <!-- Тень всплывающих панелей -->
    <DropShadowEffect x:Key="PopupShadowEffect"
                      Color="#0F172A"
                      BlurRadius="28"
                      ShadowDepth="6"
                      Direction="270"
                      Opacity="0.16" />

</ResourceDictionary>
