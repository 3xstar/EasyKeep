<UserControl x:Class="EasyKeep.Views.StocksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="StocksView_Loaded">

    <UserControl.Resources>
        <Style x:Key="NumberCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- KPI-виджеты: клик мгновенно фильтрует таблицу -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <RadioButton x:Name="KpiAll"
                         Grid.Column="0"
                         Style="{StaticResource KpiCard}"
                         GroupName="StockKpi"
                         Tag="all"
                         IsChecked="True"
                         Margin="0,0,12,0"
                         AutomationProperties.Name="Всего позиций"
                         Checked="KpiFilter_Checked">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Всего позиций"
                                   Style="{StaticResource KpiLabelText}"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="KpiAllText" Text="—" Style="{StaticResource KpiValueText}" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="KpiCritical"
                         Grid.Column="1"
                         Style="{StaticResource KpiCard}"
                         GroupName="StockKpi"
                         Tag="critical"
                         Margin="0,0,12,0"
                         AutomationProperties.Name="Критичный дефицит"
                         Checked="KpiFilter_Checked">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource DangerBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Критичный дефицит"
                                   Style="{StaticResource KpiLabelText}"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="KpiCriticalText" Text="—" Style="{StaticResource KpiValueText}" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="KpiWarning"
                         Grid.Column="2"
                         Style="{StaticResource KpiCard}"
                         GroupName="StockKpi"
                         Tag="warning"
                         Margin="0,0,12,0"
                         AutomationProperties.Name="Внимание"
                         Checked="KpiFilter_Checked">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource WarningBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Внимание"
                                   Style="{StaticResource KpiLabelText}"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="KpiWarningText" Text="—" Style="{StaticResource KpiValueText}" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="KpiNonLiquid"
                         Grid.Column="3"
                         Style="{StaticResource KpiCard}"
                         GroupName="StockKpi"
                         Tag="nonliquid"
                         AutomationProperties.Name="Неликвид"
                         Checked="KpiFilter_Checked">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource TextMutedBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Неликвид"
                                   Style="{StaticResource KpiLabelText}"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="KpiNonLiquidText" Text="—" Style="{StaticResource KpiValueText}" />
                </StackPanel>
            </RadioButton>
        </Grid>

        <!-- Панель фильтров -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorder}"
                Padding="16"
                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Поиск по SKU или названию"
                               Style="{StaticResource CaptionText}"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource FieldTextBox}"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="Введите артикул или часть названия товара" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Склад"
                               Style="{StaticResource CaptionText}"
                               Margin="0,0,0,6" />
                    <ComboBox x:Name="WarehouseFilter"
                              Style="{StaticResource FieldComboBox}"
                              DisplayMemberPath="Name"
                              SelectionChanged="WarehouseFilter_SelectionChanged" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Обновить"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Bottom"
                        Margin="0,0,12,0"
                        Click="RefreshButton_Click" />

                <Border Grid.Column="3"
                        Style="{StaticResource PillBorder}"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,2">
                    <TextBlock x:Name="SummaryText"
                               Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <!-- Таблица остатков -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorder}"
                Padding="0"
                Margin="0,16,0,0">
            <Grid>
                <DataGrid x:Name="StocksGrid"
                          Style="{StaticResource ModernDataGrid}"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU"
                                            Binding="{Binding Sku}"
                                            Width="100"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Товар"
                                            Binding="{Binding ItemName}"
                                            Width="*"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Склад"
                                            Binding="{Binding WarehouseName}"
                                            Width="150"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Остаток"
                                            Binding="{Binding Quantity}"
                                            Width="80"
                                            ElementStyle="{StaticResource NumberCellText}" />
                        <DataGridTextColumn Header="Минимум"
                                            Binding="{Binding MinStock}"
                                            Width="80"
                                            ElementStyle="{StaticResource NumberCellText}" />
                        <DataGridTextColumn Header="Расход/день"
                                            Binding="{Binding AverageDailyConsumption, StringFormat={}{0:0.##}}"
                                            Width="105"
                                            ElementStyle="{StaticResource NumberCellText}" />
                        <DataGridTextColumn Header="Прогноз"
                                            Binding="{Binding DaysLeftText}"
                                            Width="85"
                                            ElementStyle="{StaticResource NumberCellText}" />

                        <DataGridTemplateColumn Header="Светофор" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="StatusBadge"
                                            Background="{DynamicResource BadgeNeutralBackgroundBrush}"
                                            CornerRadius="999"
                                            Padding="10,4"
                                            HorizontalAlignment="Left">
                                        <TextBlock x:Name="StatusLabel"
                                                   Text="{Binding StatusText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BadgeNeutralForegroundBrush}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Critical">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource BadgeCriticalBackgroundBrush}" />
                                            <Setter TargetName="StatusBadge" Property="Effect" Value="{DynamicResource GlowCriticalEffect}" />
                                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource BadgeCriticalForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource BadgeWarningBackgroundBrush}" />
                                            <Setter TargetName="StatusBadge" Property="Effect" Value="{DynamicResource GlowWarningEffect}" />
                                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource BadgeWarningForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Normal">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource BadgeSuccessBackgroundBrush}" />
                                            <Setter TargetName="StatusBadge" Property="Effect" Value="{DynamicResource GlowSuccessEffect}" />
                                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource BadgeSuccessForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="NonLiquid">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource BadgeMutedBackgroundBrush}" />
                                            <Setter TargetName="StatusBadge" Property="Effect" Value="{DynamicResource GlowMutedEffect}" />
                                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource BadgeMutedForegroundBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="StateText"
                           Style="{StaticResource EmptyStateText}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
