<UserControl x:Class="EasyKeep.Views.StocksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="StocksView_Loaded">

    <UserControl.Resources>
        <Style x:Key="NumberCellText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <!-- Компенсация зоны индикатора сортировки в шапке (14 px) -->
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Светофор, полный режим: бейдж со статусом -->
        <DataTemplate x:Key="FullTrafficLightTemplate">
            <Border x:Name="StatusBadge"
                    Background="{DynamicResource BadgeNeutralBackgroundBrush}"
                    CornerRadius="999"
                    Padding="10,4"
                    HorizontalAlignment="Left">
                <TextBlock x:Name="StatusLabel"
                           FontSize="{DynamicResource FontSizeSmall}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BadgeNeutralForegroundBrush}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Critical">
                    <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource BadgeCriticalBackgroundBrush}" />
                    <Setter TargetName="StatusBadge" Property="Effect" Value="{DynamicResource GlowCriticalEffect}" />
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource BadgeCriticalForegroundBrush}" />
                    <Setter TargetName="StatusLabel" Property="Text" Value="{DynamicResource Loc_Status_Critical}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource BadgeWarningBackgroundBrush}" />
                    <Setter TargetName="StatusBadge" Property="Effect" Value="{DynamicResource GlowWarningEffect}" />
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource BadgeWarningForegroundBrush}" />
                    <Setter TargetName="StatusLabel" Property="Text" Value="{DynamicResource Loc_Status_Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Normal">
                    <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource BadgeSuccessBackgroundBrush}" />
                    <Setter TargetName="StatusBadge" Property="Effect" Value="{DynamicResource GlowSuccessEffect}" />
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource BadgeSuccessForegroundBrush}" />
                    <Setter TargetName="StatusLabel" Property="Text" Value="{DynamicResource Loc_Status_Normal}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NonLiquid">
                    <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource BadgeMutedBackgroundBrush}" />
                    <Setter TargetName="StatusBadge" Property="Effect" Value="{DynamicResource GlowMutedEffect}" />
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource BadgeMutedForegroundBrush}" />
                    <Setter TargetName="StatusLabel" Property="Text" Value="{DynamicResource Loc_Status_NonLiquid}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Светофор, компактный режим: только индикатор, статус и прогноз в подсказке -->
        <DataTemplate x:Key="CompactTrafficLightTemplate">
            <Ellipse x:Name="CompactDot"
                     Width="11"
                     Height="11"
                     Fill="{DynamicResource TextMutedBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Ellipse.ToolTip>
                    <StackPanel>
                        <TextBlock x:Name="CompactStatusText" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DaysLeftText}" />
                    </StackPanel>
                </Ellipse.ToolTip>
            </Ellipse>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Critical">
                    <Setter TargetName="CompactDot" Property="Fill" Value="{DynamicResource DangerBrush}" />
                    <Setter TargetName="CompactStatusText" Property="Text" Value="{DynamicResource Loc_Status_Critical}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter TargetName="CompactDot" Property="Fill" Value="{DynamicResource WarningBrush}" />
                    <Setter TargetName="CompactStatusText" Property="Text" Value="{DynamicResource Loc_Status_Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Normal">
                    <Setter TargetName="CompactDot" Property="Fill" Value="{DynamicResource SuccessBrush}" />
                    <Setter TargetName="CompactStatusText" Property="Text" Value="{DynamicResource Loc_Status_Normal}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NonLiquid">
                    <Setter TargetName="CompactStatusText" Property="Text" Value="{DynamicResource Loc_Status_NonLiquid}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- KPI-виджеты: клик мгновенно фильтрует таблицу -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <RadioButton x:Name="KpiAll"
                         Grid.Column="0"
                         Style="{StaticResource KpiCard}"
                         GroupName="StockKpi"
                         Tag="all"
                         IsChecked="True"
                         Margin="0,0,12,0"
                         AutomationProperties.Name="{DynamicResource Loc_Stocks_KpiAll}"
                         Checked="KpiFilter_Checked">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_Stocks_KpiAll}"
                                   Style="{StaticResource KpiLabelText}"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="KpiAllText" Text="—" Style="{StaticResource KpiValueText}" FontFamily="{DynamicResource MonoFontFamily}" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="KpiCritical"
                         Grid.Column="1"
                         Style="{StaticResource KpiCard}"
                         GroupName="StockKpi"
                         Tag="critical"
                         Margin="0,0,12,0"
                         AutomationProperties.Name="{DynamicResource Loc_Stocks_KpiCritical}"
                         Checked="KpiFilter_Checked">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource DangerBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_Stocks_KpiCritical}"
                                   Style="{StaticResource KpiLabelText}"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="KpiCriticalText" Text="—" Style="{StaticResource KpiValueText}" FontFamily="{DynamicResource MonoFontFamily}" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="KpiWarning"
                         Grid.Column="2"
                         Style="{StaticResource KpiCard}"
                         GroupName="StockKpi"
                         Tag="warning"
                         Margin="0,0,12,0"
                         AutomationProperties.Name="{DynamicResource Loc_Stocks_KpiWarning}"
                         Checked="KpiFilter_Checked">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource WarningBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_Stocks_KpiWarning}"
                                   Style="{StaticResource KpiLabelText}"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="KpiWarningText" Text="—" Style="{StaticResource KpiValueText}" FontFamily="{DynamicResource MonoFontFamily}" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="KpiNonLiquid"
                         Grid.Column="3"
                         Style="{StaticResource KpiCard}"
                         GroupName="StockKpi"
                         Tag="nonliquid"
                         AutomationProperties.Name="{DynamicResource Loc_Stocks_KpiNonLiquid}"
                         Checked="KpiFilter_Checked">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource TextMutedBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_Stocks_KpiNonLiquid}"
                                   Style="{StaticResource KpiLabelText}"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="KpiNonLiquidText" Text="—" Style="{StaticResource KpiValueText}" FontFamily="{DynamicResource MonoFontFamily}" />
                </StackPanel>
            </RadioButton>
        </Grid>

        <!-- Панель фильтров -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorder}"
                Padding="16"
                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{DynamicResource Loc_Common_SearchLabel}"
                           Style="{StaticResource FieldLabelText}"
                           VerticalAlignment="Bottom"
                           Margin="0,0,12,6" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{DynamicResource Loc_Common_HeaderWarehouse}"
                           Style="{StaticResource FieldLabelText}"
                           VerticalAlignment="Bottom"
                           Margin="0,0,12,6" />

                <TextBox Grid.Row="1" Grid.Column="0"
                         x:Name="SearchBox"
                         Style="{StaticResource FieldTextBox}"
                         Height="{DynamicResource ControlHeight}"
                         Margin="0,0,12,0"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="{DynamicResource Loc_Common_SearchTooltip}" />
                <ComboBox Grid.Row="1" Grid.Column="1"
                          x:Name="WarehouseFilter"
                          Style="{StaticResource FieldComboBox}"
                          Height="{DynamicResource ControlHeight}"
                          Margin="0,0,12,0"
                          DisplayMemberPath="Name"
                          SelectionChanged="WarehouseFilter_SelectionChanged" />

                <Button Grid.Row="1" Grid.Column="2"
                        Content="{DynamicResource Loc_Common_Refresh}"
                        Style="{StaticResource SecondaryButton}"
                        Height="{DynamicResource ControlHeight}"
                        VerticalAlignment="Bottom"
                        Margin="0,0,12,0"
                        Click="RefreshButton_Click" />

                <Border Grid.Row="1" Grid.Column="3"
                        Style="{StaticResource PillBorder}"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,2">
                    <TextBlock x:Name="SummaryText"
                               Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <!-- Таблица остатков -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorder}"
                Padding="0"
                Margin="0,16,0,0">
            <Grid>
                <DataGrid x:Name="StocksGrid"
                          Style="{StaticResource ModernDataGrid}"
                          BorderThickness="0"
                          MinHeight="180">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Loc_Common_HeaderSku}"
                                            Binding="{Binding Sku}"
                                            Width="*"
                                            MinWidth="70"
                                            ElementStyle="{StaticResource MonoCellText}" />
                        <DataGridTextColumn Header="{DynamicResource Loc_Common_HeaderItem}"
                                            Binding="{Binding ItemName}"
                                            Width="2.5*"
                                            MinWidth="150"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{DynamicResource Loc_Common_HeaderWarehouse}"
                                            Binding="{Binding WarehouseName}"
                                            Width="1.5*"
                                            MinWidth="110"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{DynamicResource Loc_Stocks_HeaderQuantity}"
                                            Binding="{Binding Quantity}"
                                            Width="*"
                                            MinWidth="70"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                            ElementStyle="{StaticResource NumberCellText}" />
                        <DataGridTextColumn Header="{DynamicResource Loc_Stocks_HeaderMin}"
                                            Binding="{Binding MinStock}"
                                            Width="*"
                                            MinWidth="76"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                            ElementStyle="{StaticResource NumberCellText}" />
                        <DataGridTextColumn Header="{DynamicResource Loc_Stocks_HeaderRate}"
                                            Binding="{Binding AverageDailyConsumption, StringFormat={}{0:0.##}}"
                                            Width="*"
                                            MinWidth="84"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                            ElementStyle="{StaticResource NumberCellText}" />
                        <DataGridTextColumn Header="{DynamicResource Loc_Stocks_HeaderForecast}"
                                            Binding="{Binding DaysLeftText}"
                                            Width="*"
                                            MinWidth="76"
                                            HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                            ElementStyle="{StaticResource NumberCellText}" />

                        <DataGridTemplateColumn x:Name="TrafficLightColumn"
                                                SortMemberPath="Status"
                                                CanUserSort="False"
                                                Width="136"
                                                MinWidth="136"
                                                HeaderStyle="{StaticResource GridColumnHeaderCenterStyle}"
                                                CellTemplate="{StaticResource FullTrafficLightTemplate}">
                            <DataGridTemplateColumn.Header>
                                <!-- Заголовок — только компактная кнопка-иконка:
                                     в полном режиме три кружка, в компактном один. -->
                                <Button x:Name="CompactModeButton"
                                        Style="{StaticResource GhostButton}"
                                        Padding="4,2"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ToolTip="{DynamicResource Loc_Stocks_TrafficTooltip}"
                                        AutomationProperties.Name="{DynamicResource Loc_Stocks_TrafficTooltip}"
                                        Click="CompactModeButton_Click">
                                    <Grid Width="18" Height="12">
                                        <Canvas x:Name="MultiDotIcon" Width="18" Height="12">
                                            <Ellipse Canvas.Left="0" Canvas.Top="3"
                                                     Width="6" Height="6"
                                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <Ellipse Canvas.Left="6" Canvas.Top="3"
                                                     Width="6" Height="6"
                                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                     Opacity="0.65" />
                                            <Ellipse Canvas.Left="12" Canvas.Top="3"
                                                     Width="6" Height="6"
                                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                     Opacity="0.35" />
                                        </Canvas>
                                        <Ellipse x:Name="SingleDotIcon"
                                                 Width="7" Height="7"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Visibility="Collapsed"
                                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Grid>
                                </Button>
                            </DataGridTemplateColumn.Header>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="StateText"
                           Style="{StaticResource TableEmptyStateText}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
