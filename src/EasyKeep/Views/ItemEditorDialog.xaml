<Window x:Class="EasyKeep.Views.ItemEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар"
        Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeaderText" Text="Новый товар" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="Заполните карточку номенклатуры. SKU должен быть уникальным."
                       Style="{StaticResource CaptionText}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="SKU *" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                <TextBox x:Name="SkuBox" Style="{StaticResource FieldTextBox}" MaxLength="50" />

                <TextBlock Text="Название *" Style="{StaticResource CaptionText}" Margin="0,12,0,6" />
                <TextBox x:Name="NameBox" Style="{StaticResource FieldTextBox}" MaxLength="200" />

                <TextBlock Text="Категория *" Style="{StaticResource CaptionText}" Margin="0,12,0,6" />
                <ComboBox x:Name="CategoryCombo"
                          Style="{StaticResource FieldComboBox}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Единица *" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                        <TextBox x:Name="UnitBox" Style="{StaticResource FieldTextBox}" MaxLength="20" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Цена" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                        <TextBox x:Name="PriceBox" Style="{StaticResource FieldTextBox}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Мин. остаток" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                        <TextBox x:Name="MinStockBox" Style="{StaticResource FieldTextBox}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Минимальный остаток используется «Светофором дефицита» как неснижаемый порог."
                           Style="{StaticResource CaptionText}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11"
                           Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Button Content="Отмена"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left"
                    IsCancel="True" />
            <Button Content="Сохранить"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    Click="SaveButton_Click" />
        </Grid>
    </Grid>
</Window>
