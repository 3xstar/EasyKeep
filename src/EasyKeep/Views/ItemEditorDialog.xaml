<Window x:Class="EasyKeep.Views.ItemEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар"
        Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeaderText" Text="{DynamicResource Loc_ItemDialog_New}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{DynamicResource Loc_ItemDialog_Subtitle}"
                       Style="{StaticResource CaptionText}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Форма прокручивается, если при крупном масштабе не влезает;
             кнопки остаются закреплёнными внизу. -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,18,0,0"
                      Focusable="False">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_ItemDialog_SkuLabel}" Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                    <TextBox x:Name="SkuBox" Style="{StaticResource FieldTextBox}" MaxLength="50" />

                    <TextBlock Text="{DynamicResource Loc_ItemDialog_NameLabel}" Style="{StaticResource FieldLabelText}" Margin="0,12,0,6" />
                    <TextBox x:Name="NameBox" Style="{StaticResource FieldTextBox}" MaxLength="200" />

                    <TextBlock Text="{DynamicResource Loc_ItemDialog_CategoryLabel}" Style="{StaticResource FieldLabelText}" Margin="0,12,0,6" />
                    <ComboBox x:Name="CategoryCombo"
                              Style="{StaticResource FieldComboBox}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Loc_ItemDialog_UnitLabel}" Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                            <TextBox x:Name="UnitBox" Style="{StaticResource FieldTextBox}" MaxLength="20" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Loc_ItemDialog_PriceLabel}" Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                            <TextBox x:Name="PriceBox" Style="{StaticResource FieldTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Loc_ItemDialog_MinStockLabel}" Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                            <TextBox x:Name="MinStockBox" Style="{StaticResource FieldTextBox}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource Loc_ItemDialog_MinStockHint}"
                               Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Button Content="{DynamicResource Loc_Common_Cancel}"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left"
                    IsCancel="True" />
            <Button Content="{DynamicResource Loc_Common_Save}"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    Click="SaveButton_Click" />
        </Grid>
    </Grid>
</Window>
