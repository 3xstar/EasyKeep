<UserControl x:Class="EasyKeep.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="ReportsView_Loaded">

    <UserControl.Resources>
        <Style x:Key="NumberCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <!-- Компенсация зоны индикатора сортировки в шапке (14 px) -->
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TableBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== Сводные метрики ==================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_Rep_KpiTotalQuantity}"
                                   Style="{StaticResource KpiLabelText}"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="TotalQuantityText"
                               Text="—"
                               Style="{StaticResource KpiValueText}" />
                    <TextBlock Text="{DynamicResource Loc_Rep_KpiTotalQuantityHint}"
                               Style="{StaticResource KpiHintText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource StatCard}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource SuccessBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_Rep_KpiTotalValue}"
                                   Style="{StaticResource KpiLabelText}"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="TotalValueText"
                               Text="—"
                               Style="{StaticResource KpiValueText}"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{DynamicResource Loc_Rep_KpiTotalValueHint}"
                               Style="{StaticResource KpiHintText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource InfoBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_Rep_KpiLeader}"
                                   Style="{StaticResource KpiLabelText}"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="LeaderNameText"
                               Text="—"
                               Style="{StaticResource KpiValueText}"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               TextWrapping="NoWrap" />
                    <TextBlock x:Name="LeaderDetailText"
                               Text="{DynamicResource Loc_Rep_LeaderPeriodHint}"
                               Style="{StaticResource KpiHintText}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== Отчёты ==================== -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Остатки по складам -->
            <Border Style="{StaticResource CardBorder}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc_Rep_StockTitle}"
                                       Style="{StaticResource SectionTitleText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Loc_Rep_StockSubtitle}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Margin="12,0,0,0">
                            <Border Style="{StaticResource PillBorder}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Loc_Common_WarehousesCount}"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="WarehouseCountText"
                                               Text="—"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Content="{DynamicResource Loc_Common_Refresh}"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    Padding="12,7"
                                    Click="RefreshStockButton_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource TableBorder}" Margin="0,14,0,0">
                        <Grid>
                            <DataGrid x:Name="StockGrid"
                                      Style="{StaticResource ModernDataGrid}"
                                      BorderThickness="0"
                                      MinHeight="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Loc_Common_HeaderWarehouse}"
                                                        Binding="{Binding WarehouseName}"
                                                        Width="2*"
                                                        MinWidth="130"
                                                        ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="{DynamicResource Loc_Common_HeaderItems}"
                                                        Binding="{Binding ItemsCount}"
                                                        Width="*"
                                                        MinWidth="62"
                                                        HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                                        ElementStyle="{StaticResource NumberCellText}" />
                                    <DataGridTextColumn Header="{DynamicResource Loc_Mov_HeaderQuantity}"
                                                        Binding="{Binding TotalQuantity}"
                                                        Width="*"
                                                        MinWidth="70"
                                                        HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                                        ElementStyle="{StaticResource NumberCellText}" />
                                    <DataGridTextColumn Header="{DynamicResource Loc_Rep_HeaderValue}"
                                                        Binding="{Binding TotalValue, StringFormat={}{0:N2}}"
                                                        Width="*"
                                                        MinWidth="92"
                                                        HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                                        ElementStyle="{StaticResource NumberCellText}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="StockStateText"
                                       Style="{StaticResource TableEmptyStateText}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Топ активных товаров -->
            <Border Grid.Column="1"
                    Style="{StaticResource CardBorder}"
                    Padding="18"
                    Margin="16,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_Rep_TopTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{DynamicResource Loc_Rep_TopSubtitle}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{DynamicResource Loc_Mov_FromDate}" Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                            <DatePicker x:Name="FromDatePicker" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="{DynamicResource Loc_Mov_ToDate}" Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                            <DatePicker x:Name="ToDatePicker" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="{DynamicResource Loc_Common_Build}"
                                Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Bottom"
                                Click="BuildTopButton_Click" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,14,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Loc_Rep_RatingLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Style="{StaticResource PillBorder}"
                                Margin="12,0,0,0">
                            <TextBlock x:Name="TopSummaryText"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Style="{StaticResource TableBorder}">
                        <Grid>
                            <DataGrid x:Name="TopItemsGrid"
                                      Style="{StaticResource ModernDataGrid}"
                                      BorderThickness="0"
                                      MinHeight="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Loc_Common_HeaderSku}"
                                                        Binding="{Binding Sku}"
                                                        Width="*"
                                                        MinWidth="56"
                                                        ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="{DynamicResource Loc_Common_HeaderItem}"
                                                        Binding="{Binding Name}"
                                                        Width="2*"
                                                        MinWidth="130"
                                                        ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="{DynamicResource Loc_Rep_HeaderOut}"
                                                        Binding="{Binding OutQuantity}"
                                                        Width="*"
                                                        MinWidth="62"
                                                        HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                                        ElementStyle="{StaticResource NumberCellText}" />
                                    <DataGridTextColumn Header="{DynamicResource Loc_Rep_HeaderTransfers}"
                                                        Binding="{Binding TransferQuantity}"
                                                        Width="*"
                                                        MinWidth="58"
                                                        HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                                        ElementStyle="{StaticResource NumberCellText}" />
                                    <DataGridTextColumn Header="{DynamicResource Loc_Rep_HeaderMovements}"
                                                        Binding="{Binding MovementsCount}"
                                                        Width="*"
                                                        MinWidth="56"
                                                        HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                                        ElementStyle="{StaticResource NumberCellText}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="TopStateText"
                                       Style="{StaticResource TableEmptyStateText}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
