<UserControl x:Class="EasyKeep.Views.MovementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="MovementsView_Loaded">

    <UserControl.Resources>
        <Style x:Key="NumberCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <!-- Компенсация зоны индикатора сортировки в шапке (14 px) -->
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="340" />
            <ColumnDefinition Width="1.6*" MinWidth="400" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Форма нового документа ==================== -->
        <Border Style="{StaticResource CardBorder}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Новый документ"
                               Style="{StaticResource SectionTitleText}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Content="Авто-балансировка"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="{DynamicResource FontSizeSmall}"
                            Padding="10,6"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Click="AutoBalanceButton_Click" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock Text="Тип операции" Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                    <ComboBox x:Name="TypeCombo"
                              Style="{StaticResource FieldComboBox}"
                              SelectionChanged="TypeCombo_SelectionChanged">
                        <ComboBoxItem Content="Приход (IN)" Tag="IN" />
                        <ComboBoxItem Content="Расход (OUT)" Tag="OUT" />
                        <ComboBoxItem Content="Перемещение (TRANSFER)" Tag="TRANSFER" />
                    </ComboBox>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="SourceWarehousePanel">
                        <TextBlock Text="Склад-источник" Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                        <ComboBox x:Name="SourceWarehouse"
                                  Style="{StaticResource FieldComboBox}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>

                    <StackPanel x:Name="TargetWarehousePanel" Grid.Column="1">
                        <TextBlock Text="Склад-получатель" Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                        <ComboBox x:Name="TargetWarehouse"
                                  Style="{StaticResource FieldComboBox}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource AppSeparator}" />

                <StackPanel Grid.Row="4">
                    <TextBlock Text="Командная строка склада"
                               Style="{StaticResource SectionTitleText}"
                               FontSize="{DynamicResource FontSizeBase}" />
                    <TextBox x:Name="CommandLineBox"
                             Style="{StaticResource FieldTextBox}"
                             Margin="0,6,0,0"
                             MaxLength="100"
                             KeyDown="CommandLineBox_KeyDown"
                             ToolTip="Введите SKU или часть названия и нажмите Enter" />
                    <TextBlock x:Name="CommandFeedbackText"
                               Style="{StaticResource CaptionText}"
                               MinHeight="16"
                               Margin="0,4,0,0" />
                    <TextBlock Text="Enter добавляет позицию +1. Повторный ввод увеличивает количество."
                               Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="{DynamicResource FontSizeSmall}" />
                </StackPanel>

                <Grid Grid.Row="5" Margin="0,12,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Позиции документа"
                               Style="{StaticResource SectionTitleText}"
                               FontSize="{DynamicResource FontSizeBase}" />
                    <TextBlock x:Name="DocumentSummaryText"
                               Grid.Column="1"
                               Style="{StaticResource CaptionText}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="6">
                    <DataGrid x:Name="LinesGrid"
                              Style="{StaticResource ModernDataGrid}"
                              IsReadOnly="False"
                              MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU"
                                                Binding="{Binding Sku}"
                                                IsReadOnly="True"
                                                Width="*"
                                                MinWidth="70" />
                            <DataGridTextColumn Header="Товар"
                                                Binding="{Binding Name}"
                                                IsReadOnly="True"
                                                Width="2*"
                                                MinWidth="110" />
                            <DataGridTextColumn Header="Кол-во"
                                                Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"
                                                MinWidth="54"
                                                HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                                ElementStyle="{StaticResource NumberCellText}" />
                            <DataGridTextColumn Header="Ед."
                                                Binding="{Binding Unit}"
                                                IsReadOnly="True"
                                                Width="Auto" />
                            <DataGridTemplateColumn Width="Auto" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="✕"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Cursor="Hand"
                                                   ToolTip="Удалить позицию"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   MouseLeftButtonUp="RemoveLine_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="LinesEmptyText"
                               Text="Добавьте товар через командную строку выше."
                               Style="{StaticResource TableEmptyStateText}"
                               IsHitTestVisible="False" />
                </Grid>

                <StackPanel Grid.Row="7" Margin="0,10,0,0">
                    <TextBlock Text="Комментарий (необязательно)" Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                    <TextBox x:Name="CommentBox"
                             Style="{StaticResource FieldTextBox}"
                             MaxLength="500" />
                </StackPanel>

                <Grid Grid.Row="8" Margin="0,14,0,0">
                    <Button Content="Очистить"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left"
                            Click="ClearButton_Click" />
                    <Button Content="Провести документ"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right"
                            Click="PostButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== Журнал операций ==================== -->
        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="С даты"
                               Style="{StaticResource FieldLabelText}"
                               VerticalAlignment="Bottom"
                               Margin="0,0,10,6" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="По дату"
                               Style="{StaticResource FieldLabelText}"
                               VerticalAlignment="Bottom"
                               Margin="0,0,10,6" />
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="Тип операции"
                               Style="{StaticResource FieldLabelText}"
                               VerticalAlignment="Bottom"
                               Margin="0,0,10,6" />

                    <DatePicker Grid.Row="1" Grid.Column="0"
                                x:Name="FromDatePicker"
                                Margin="0,0,10,0"
                                SelectedDateChanged="JournalFilter_Changed" />
                    <DatePicker Grid.Row="1" Grid.Column="1"
                                x:Name="ToDatePicker"
                                Margin="0,0,10,0"
                                SelectedDateChanged="JournalFilter_Changed" />
                    <ComboBox Grid.Row="1" Grid.Column="2"
                              x:Name="TypeFilter"
                              Style="{StaticResource FieldComboBox}"
                              Margin="0,0,10,0"
                              SelectionChanged="JournalFilter_Changed">
                        <ComboBoxItem Content="Все операции" Tag="" />
                        <ComboBoxItem Content="Приход" Tag="IN" />
                        <ComboBoxItem Content="Расход" Tag="OUT" />
                        <ComboBoxItem Content="Перемещение" Tag="TRANSFER" />
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Склад"
                               Style="{StaticResource FieldLabelText}"
                               VerticalAlignment="Bottom"
                               Margin="0,10,10,6" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                               Text="Поиск по товару"
                               Style="{StaticResource FieldLabelText}"
                               VerticalAlignment="Bottom"
                               Margin="0,10,10,6" />

                    <ComboBox Grid.Row="3" Grid.Column="0"
                              x:Name="JournalWarehouse"
                              Style="{StaticResource FieldComboBox}"
                              Height="{DynamicResource ControlHeight}"
                              Margin="0,0,10,0"
                              DisplayMemberPath="Name"
                              SelectionChanged="JournalFilter_Changed" />
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                             x:Name="JournalSearchBox"
                             Style="{StaticResource FieldTextBox}"
                             Height="{DynamicResource ControlHeight}"
                             MinWidth="180"
                             HorizontalAlignment="Stretch"
                             Margin="0,0,10,0"
                             MaxLength="100"
                             KeyDown="JournalSearchBox_KeyDown" />
                    <Button Grid.Row="3" Grid.Column="3"
                            Content="Показать"
                            Style="{StaticResource PrimaryButton}"
                            Height="{DynamicResource ControlHeight}"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,0"
                            Click="RefreshJournalButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource CardBorder}"
                    Padding="0"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="18,14,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Журнал операций"
                                   Style="{StaticResource SectionTitleText}"
                                   TextWrapping="Wrap" />
                        <Border Grid.Column="1"
                                Style="{StaticResource PillBorder}"
                                Margin="12,0,0,0">
                            <TextBlock x:Name="JournalSummaryText"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="JournalGrid"
                                  Style="{StaticResource ModernDataGrid}"
                                  BorderThickness="0"
                                  MinHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата"
                                                    Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                    Width="*"
                                                    MinWidth="108" />
                                <DataGridTemplateColumn Header="Тип" Width="Auto" SortMemberPath="Type">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="TypeBadge"
                                                    Background="{DynamicResource BadgeNeutralBackgroundBrush}"
                                                    CornerRadius="999"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left">
                                                <TextBlock x:Name="TypeLabel"
                                                           Text="{Binding TypeText}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BadgeNeutralForegroundBrush}" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="IN">
                                                    <Setter TargetName="TypeBadge" Property="Background" Value="{DynamicResource BadgeSuccessBackgroundBrush}" />
                                                    <Setter TargetName="TypeBadge" Property="Effect" Value="{DynamicResource GlowSuccessEffect}" />
                                                    <Setter TargetName="TypeLabel" Property="Foreground" Value="{DynamicResource BadgeSuccessForegroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="OUT">
                                                    <Setter TargetName="TypeBadge" Property="Background" Value="{DynamicResource BadgeCriticalBackgroundBrush}" />
                                                    <Setter TargetName="TypeBadge" Property="Effect" Value="{DynamicResource GlowCriticalEffect}" />
                                                    <Setter TargetName="TypeLabel" Property="Foreground" Value="{DynamicResource BadgeCriticalForegroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="TRANSFER">
                                                    <Setter TargetName="TypeBadge" Property="Background" Value="{DynamicResource BadgeInfoBackgroundBrush}" />
                                                    <Setter TargetName="TypeBadge" Property="Effect" Value="{DynamicResource GlowSuccessEffect}" />
                                                    <Setter TargetName="TypeLabel" Property="Foreground" Value="{DynamicResource BadgeInfoForegroundBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Маршрут"
                                                    Binding="{Binding RouteText}"
                                                    Width="2*"
                                                    MinWidth="140" />
                                <DataGridTextColumn Header="Позиций"
                                                    Binding="{Binding ItemsCount}"
                                                    Width="*"
                                                    MinWidth="62"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                                    ElementStyle="{StaticResource NumberCellText}" />
                                <DataGridTextColumn Header="Единиц"
                                                    Binding="{Binding TotalQuantity}"
                                                    Width="*"
                                                    MinWidth="62"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                                    ElementStyle="{StaticResource NumberCellText}" />
                                <DataGridTextColumn Header="Комментарий"
                                                    Binding="{Binding Comment}"
                                                    Width="1.2*"
                                                    MinWidth="100" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="JournalStateText"
                                   Style="{StaticResource TableEmptyStateText}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
