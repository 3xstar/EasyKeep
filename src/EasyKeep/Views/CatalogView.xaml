<UserControl x:Class="EasyKeep.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="CatalogView_Loaded">

    <UserControl.Resources>
        <Style x:Key="NumberCellText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <!-- Компенсация зоны индикатора сортировки в шапке (14 px) -->
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.9*" MinWidth="420" />
            <ColumnDefinition Width="*" MinWidth="290" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Фильтры и действия -->
            <Border Style="{StaticResource CardBorder}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*" MinWidth="170" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Loc_Common_SearchLabel}" Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource FieldTextBox}"
                                 TextChanged="SearchBox_TextChanged"
                                 ToolTip="{DynamicResource Loc_Common_SearchTooltip}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource Loc_Cat_CategoryLabel}" Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                        <ComboBox x:Name="CategoryFilter"
                                  Style="{StaticResource FieldComboBox}"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="CategoryFilter_SelectionChanged" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2"
                               Margin="0,10,0,0">
                        <Button Content="{DynamicResource Loc_Cat_AddItem}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,8"
                                Click="AddItemButton_Click" />
                        <Button Content="{DynamicResource Loc_Cat_CategoriesButton}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,8"
                                Click="CategoriesButton_Click" />
                        <Button Content="{DynamicResource Loc_Common_Edit}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,8"
                                Click="EditItemButton_Click" />
                        <Button Content="{DynamicResource Loc_Common_Delete}"
                                Style="{StaticResource DangerButton}"
                                Margin="0,0,8,8"
                                Click="DeleteItemButton_Click" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Таблица товаров -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardBorder}"
                    Padding="0"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="18,14,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Loc_Cat_ItemsTitle}"
                                   Style="{StaticResource SectionTitleText}"
                                   TextWrapping="Wrap" />
                        <Border Grid.Column="1"
                                Style="{StaticResource PillBorder}"
                                Margin="12,0,0,0">
                            <TextBlock x:Name="SummaryText"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="ItemsGrid"
                                  Style="{StaticResource ModernDataGrid}"
                                  BorderThickness="0"
                                  MinHeight="180"
                                  SelectionChanged="ItemsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Loc_Common_HeaderSku}"
                                                    Binding="{Binding Sku}"
                                                    Width="*"
                                                    MinWidth="70"
                                                    ElementStyle="{StaticResource MonoCellText}" />
                                <DataGridTextColumn Header="{DynamicResource Loc_Common_HeaderItem}"
                                                    Binding="{Binding Name}"
                                                    Width="2.5*"
                                                    MinWidth="150" />
                                <DataGridTextColumn Header="{DynamicResource Loc_Cat_HeaderCategory}"
                                                    Binding="{Binding Category.Name}"
                                                    Width="1.4*"
                                                    MinWidth="100" />
                                <DataGridTextColumn Header="{DynamicResource Loc_Common_UnitShort}"
                                                    Binding="{Binding Unit}"
                                                    Width="Auto" />
                                <DataGridTextColumn Header="{DynamicResource Loc_Cat_HeaderPrice}"
                                                    Binding="{Binding Price, StringFormat={}{0:0.00}}"
                                                    Width="*"
                                                    MinWidth="72"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                                    ElementStyle="{StaticResource NumberCellText}" />
                                <DataGridTextColumn Header="{DynamicResource Loc_Cat_HeaderMin}"
                                                    Binding="{Binding MinStock}"
                                                    Width="*"
                                                    MinWidth="54"
                                                    HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                                    ElementStyle="{StaticResource NumberCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="StateText"
                                   Style="{StaticResource TableEmptyStateText}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Рентген товара -->
        <Border x:Name="XRayPanel"
                Grid.Column="1"
                Style="{StaticResource CardBorder}"
                Margin="16,0,0,0"
                Padding="18">
            <Border.RenderTransform>
                <TranslateTransform x:Name="XRayShift" X="0" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_Cat_XRayTitle}" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{DynamicResource Loc_Cat_XRaySubtitle}"
                               Style="{StaticResource CaptionText}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock x:Name="XRayItemName"
                               Text="{DynamicResource Loc_Cat_XRayNoItem}"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="XRayMeta"
                               Text="{DynamicResource Loc_Cat_XRayNoItemHint}"
                               Style="{StaticResource CaptionText}"
                               Margin="0,3,0,0" />
                    <Border Style="{StaticResource AppSeparator}" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="HistoryList" Margin="0,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding DateText}"
                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <Border x:Name="HistoryTypeBadge"
                                                        Background="{DynamicResource BadgeNeutralBackgroundBrush}"
                                                        CornerRadius="999"
                                                        Padding="8,2"
                                                        HorizontalAlignment="Right">
                                                    <TextBlock x:Name="HistoryTypeLabel"
                                                               FontSize="{DynamicResource FontSizeSmall}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BadgeNeutralForegroundBrush}" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding RouteText}"
                                                       FontSize="{DynamicResource FontSizeBase}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0" />

                                            <Grid Margin="0,3,0,0">
                                                <TextBlock Text="{Binding QuantityText}"
                                                           FontSize="{DynamicResource FontSizeBase}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding Comment}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Right"
                                                           MaxWidth="190"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="IN">
                                            <Setter TargetName="HistoryTypeBadge" Property="Background" Value="{DynamicResource BadgeSuccessBackgroundBrush}" />
                                            <Setter TargetName="HistoryTypeBadge" Property="Effect" Value="{DynamicResource GlowSuccessEffect}" />
                                            <Setter TargetName="HistoryTypeLabel" Property="Foreground" Value="{DynamicResource BadgeSuccessForegroundBrush}" />
                                            <Setter TargetName="HistoryTypeLabel" Property="Text" Value="{DynamicResource Loc_Type_In}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="OUT">
                                            <Setter TargetName="HistoryTypeBadge" Property="Background" Value="{DynamicResource BadgeCriticalBackgroundBrush}" />
                                            <Setter TargetName="HistoryTypeBadge" Property="Effect" Value="{DynamicResource GlowCriticalEffect}" />
                                            <Setter TargetName="HistoryTypeLabel" Property="Foreground" Value="{DynamicResource BadgeCriticalForegroundBrush}" />
                                            <Setter TargetName="HistoryTypeLabel" Property="Text" Value="{DynamicResource Loc_Type_Out}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="TRANSFER">
                                            <Setter TargetName="HistoryTypeBadge" Property="Background" Value="{DynamicResource BadgeInfoBackgroundBrush}" />
                                            <Setter TargetName="HistoryTypeBadge" Property="Effect" Value="{DynamicResource GlowSuccessEffect}" />
                                            <Setter TargetName="HistoryTypeLabel" Property="Foreground" Value="{DynamicResource BadgeInfoForegroundBrush}" />
                                            <Setter TargetName="HistoryTypeLabel" Property="Text" Value="{DynamicResource Loc_Type_Transfer}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="HistoryStateText"
                               Style="{StaticResource EmptyStateText}"
                               Text="{DynamicResource Loc_Cat_SelectItem}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
