<UserControl x:Class="EasyKeep.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="CatalogView_Loaded">

    <UserControl.Resources>
        <Style x:Key="NumberCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Фильтры и действия -->
            <Border Style="{StaticResource CardBorder}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Поиск по SKU или названию" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource FieldTextBox}"
                                 TextChanged="SearchBox_TextChanged"
                                 ToolTip="Введите артикул или часть названия товара" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Категория" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                        <ComboBox x:Name="CategoryFilter"
                                  Style="{StaticResource FieldComboBox}"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="CategoryFilter_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <Button Content="Добавить товар"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0"
                                Click="AddItemButton_Click" />
                        <Button Content="Категории"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="CategoriesButton_Click" />
                        <Button Content="Изменить"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="EditItemButton_Click" />
                        <Button Content="Удалить"
                                Style="{StaticResource DangerButton}"
                                Click="DeleteItemButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Таблица товаров -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardBorder}"
                    Padding="0"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="18,14,18,10">
                        <TextBlock Text="Товары каталога" Style="{StaticResource SectionTitleText}" />
                        <Border Style="{StaticResource PillBorder}" HorizontalAlignment="Right">
                            <TextBlock x:Name="SummaryText"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="ItemsGrid"
                                  Style="{StaticResource ModernDataGrid}"
                                  BorderThickness="0"
                                  SelectionChanged="ItemsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU"
                                                    Binding="{Binding Sku}"
                                                    Width="95" />
                                <DataGridTextColumn Header="Товар"
                                                    Binding="{Binding Name}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Категория"
                                                    Binding="{Binding Category.Name}"
                                                    Width="120" />
                                <DataGridTextColumn Header="Ед."
                                                    Binding="{Binding Unit}"
                                                    Width="50" />
                                <DataGridTextColumn Header="Цена, ₽"
                                                    Binding="{Binding Price, StringFormat={}{0:0.00}}"
                                                    Width="85"
                                                    ElementStyle="{StaticResource NumberCellText}" />
                                <DataGridTextColumn Header="Мин."
                                                    Binding="{Binding MinStock}"
                                                    Width="60"
                                                    ElementStyle="{StaticResource NumberCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="StateText"
                                   Style="{StaticResource EmptyStateText}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Рентген товара -->
        <Border x:Name="XRayPanel"
                Grid.Column="1"
                Style="{StaticResource CardBorder}"
                Margin="16,0,0,0"
                Padding="18">
            <Border.RenderTransform>
                <TranslateTransform x:Name="XRayShift" X="0" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Рентген товара" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="История всех движений выбранной позиции."
                               Style="{StaticResource CaptionText}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock x:Name="XRayItemName"
                               Text="Товар не выбран"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="XRayMeta"
                               Text="Кликните по строке таблицы, чтобы увидеть историю."
                               Style="{StaticResource CaptionText}"
                               Margin="0,3,0,0" />
                    <Border Style="{StaticResource AppSeparator}" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="HistoryList" Margin="0,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding DateText}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <Border x:Name="HistoryTypeBadge"
                                                        Background="{DynamicResource BadgeNeutralBackgroundBrush}"
                                                        CornerRadius="999"
                                                        Padding="8,2"
                                                        HorizontalAlignment="Right">
                                                    <TextBlock x:Name="HistoryTypeLabel"
                                                               Text="{Binding TypeText}"
                                                               FontSize="{DynamicResource FontSizeSmall}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BadgeNeutralForegroundBrush}" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding RouteText}"
                                                       FontSize="{DynamicResource FontSizeBase}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0" />

                                            <Grid Margin="0,3,0,0">
                                                <TextBlock Text="{Binding QuantityText}"
                                                           FontSize="{DynamicResource FontSizeBase}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding Comment}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Right"
                                                           MaxWidth="190"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="IN">
                                            <Setter TargetName="HistoryTypeBadge" Property="Background" Value="{DynamicResource BadgeSuccessBackgroundBrush}" />
                                            <Setter TargetName="HistoryTypeBadge" Property="Effect" Value="{DynamicResource GlowSuccessEffect}" />
                                            <Setter TargetName="HistoryTypeLabel" Property="Foreground" Value="{DynamicResource BadgeSuccessForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="OUT">
                                            <Setter TargetName="HistoryTypeBadge" Property="Background" Value="{DynamicResource BadgeCriticalBackgroundBrush}" />
                                            <Setter TargetName="HistoryTypeBadge" Property="Effect" Value="{DynamicResource GlowCriticalEffect}" />
                                            <Setter TargetName="HistoryTypeLabel" Property="Foreground" Value="{DynamicResource BadgeCriticalForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="TRANSFER">
                                            <Setter TargetName="HistoryTypeBadge" Property="Background" Value="{DynamicResource BadgeInfoBackgroundBrush}" />
                                            <Setter TargetName="HistoryTypeBadge" Property="Effect" Value="{DynamicResource GlowSuccessEffect}" />
                                            <Setter TargetName="HistoryTypeLabel" Property="Foreground" Value="{DynamicResource BadgeInfoForegroundBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="HistoryStateText"
                               Style="{StaticResource EmptyStateText}"
                               Text="Выберите товар в таблице." />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
