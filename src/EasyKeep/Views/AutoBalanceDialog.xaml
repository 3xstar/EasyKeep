<Window x:Class="EasyKeep.Views.AutoBalanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авто-балансировка складов"
        Height="560" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="NumberCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <!-- Компенсация зоны индикатора сортировки в шапке (14 px) -->
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Черновики авто-балансировки"
                       Style="{StaticResource PageTitleText}" />
            <TextBlock Text="Система подобрала перемещения с основного склада на торговые точки. Проверьте цифры перед проведением."
                       Style="{StaticResource CaptionText}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardBorder}"
                Padding="0"
                Margin="0,18,0,0">
            <DataGrid x:Name="DraftsGrid"
                      Style="{StaticResource ModernDataGrid}"
                      BorderThickness="0"
                      MinHeight="180">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Торговая точка"
                                        Binding="{Binding WarehouseName}"
                                        Width="1.6*"
                                        MinWidth="140" />
                    <DataGridTextColumn Header="SKU"
                                        Binding="{Binding Sku}"
                                        Width="*"
                                        MinWidth="80" />
                    <DataGridTextColumn Header="Товар"
                                        Binding="{Binding ItemName}"
                                        Width="2*"
                                        MinWidth="140" />
                    <DataGridTextColumn Header="Количество"
                                        Binding="{Binding Quantity}"
                                        Width="*"
                                        MinWidth="90"
                                        HeaderStyle="{StaticResource GridColumnHeaderRightStyle}"
                                        ElementStyle="{StaticResource NumberCellText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText"
                       Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="12,0,0,0">
                <Button Content="Отмена"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click" />
                <Button Content="Провести все"
                        Style="{StaticResource PrimaryButton}"
                        Click="ConfirmButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
