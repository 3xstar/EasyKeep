<Window x:Class="EasyKeep.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyKeep"
        Height="800" Width="1280"
        MinHeight="640" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource PrimaryFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Масштаб интерфейса реализован без ScaleTransform и внешнего
         ScrollViewer: при смене масштаба пересчитываются ресурсы
         (FontSize*, ControlHeight, TableRowHeight, CardPadding), и
         layout с *-колонками сам ужимается под окно без «мыла» и
         горизонтальных полос прокрутки. -->
    <Grid x:Name="LayoutRoot">
        <Grid.RenderTransform>
            <!-- Подъём контейнера при запуске окна (10 px → 0, см. .cs) -->
            <TranslateTransform x:Name="WindowRise" Y="0" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Боковое меню навигации -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid x:Name="NavPanel" Margin="16,22,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Логотип и вывеска: единственный TextBlock с тенью/неоном -->
                <StackPanel x:Name="LogoPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <ContentControl x:Name="LogoImage"
                                    Style="{StaticResource EasyKeepLogo}"
                                    Width="40" Height="40" />
                    <TextBlock x:Name="BrandText"
                               Text="EasyKeep"
                               FontSize="{DynamicResource FontSizeBrand}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrandSignForegroundBrush}"
                               Effect="{DynamicResource BrandSignEffect}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>

                <!-- Разделы -->
                <StackPanel Grid.Row="1" Margin="0,28,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SectionsHeaderText"
                                   Text="{DynamicResource Loc_Nav_SectionsHeader}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                        <Button x:Name="NavToggleButton"
                                Grid.Column="1"
                                Style="{StaticResource GhostButton}"
                                Padding="6,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                ToolTip="{DynamicResource Loc_Nav_ToggleTooltip}"
                                AutomationProperties.Name="{DynamicResource Loc_Nav_ToggleTooltip}"
                                Click="NavToggleButton_Click">
                            <Path x:Name="NavToggleGlyph"
                                  Data="M6.5,1 L1.5,6 L6.5,11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="8" Height="12"
                                  Stretch="Uniform"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="NavToggleRotation" Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                    </Grid>

                    <!-- Общая капсула активного пункта: скользит между вкладками. -->
                    <Grid x:Name="NavItemsHost">
                        <Border x:Name="NavActivePill"
                                Height="36"
                                CornerRadius="8"
                                Background="{DynamicResource AccentSoftBrush}"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NavActivePillShift" Y="0" />
                            </Border.RenderTransform>
                        </Border>

                        <StackPanel>
                            <RadioButton x:Name="StocksNav"
                                         GroupName="Sections"
                                         Style="{StaticResource NavButton}"
                                         Tag="stocks"
                                         ToolTip="{DynamicResource Loc_Nav_Stocks}"
                                         AutomationProperties.Name="Остатки"
                                         Checked="NavButton_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4,20 H20 M6,20 V13 H9 V20 M11,20 V8 H14 V20 M16,20 V10 H19 V20"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="19" Height="19"
                                          Stretch="Uniform" />
                                    <TextBlock x:Name="StocksNavText" Text="{DynamicResource Loc_Nav_Stocks}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="MovementsNav"
                                         GroupName="Sections"
                                         Style="{StaticResource NavButton}"
                                         Tag="movements"
                                         ToolTip="{DynamicResource Loc_Nav_Movements}"
                                         AutomationProperties.Name="Движения"
                                         Checked="NavButton_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4,7 H16 M13,4 L17,7 L13,10 M20,17 H8 M11,14 L7,17 L11,20"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="19" Height="19"
                                          Stretch="Uniform" />
                                    <TextBlock x:Name="MovementsNavText" Text="{DynamicResource Loc_Nav_Movements}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="CatalogNav"
                                         GroupName="Sections"
                                         Style="{StaticResource NavButton}"
                                         Tag="catalog"
                                         ToolTip="{DynamicResource Loc_Nav_Catalog}"
                                         AutomationProperties.Name="Каталог"
                                         Checked="NavButton_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4,7 L12,3 L20,7 V17 L12,21 L4,17 Z M4,7 L12,11 L20,7 M12,11 V21"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="19" Height="19"
                                          Stretch="Uniform" />
                                    <TextBlock x:Name="CatalogNavText" Text="{DynamicResource Loc_Nav_Catalog}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="ReportsNav"
                                         GroupName="Sections"
                                         Style="{StaticResource NavButton}"
                                         Tag="reports"
                                         ToolTip="{DynamicResource Loc_Nav_Reports}"
                                         AutomationProperties.Name="Отчёт"
                                         Checked="NavButton_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,3 A9,9 0 1 0 21,12 H12 Z M12,3 V12 H21 A9,9 0 0 0 12,3"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"
                                          Width="19" Height="19"
                                          Stretch="Uniform" />
                                    <TextBlock x:Name="ReportsNavText" Text="{DynamicResource Loc_Nav_Reports}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Подвал меню: состояние БД и отдельная зона персонализации -->
                <StackPanel Grid.Row="3">
                    <Border x:Name="DatabaseStatusCard"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc_Shell_DbTitle}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{DynamicResource Loc_Shell_DbSubtitle}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="PersonalizationButton"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,9"
                            HorizontalContentAlignment="Left"
                            ToolTip="{DynamicResource Loc_Shell_PersonalizationTooltip}"
                            AutomationProperties.Name="{DynamicResource Loc_Shell_Personalization}"
                            Click="PersonalizationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <!-- Кисточка: знак палитры и масштаба -->
                            <Canvas Width="18" Height="18" VerticalAlignment="Center">
                                <Path Data="M11.6,1.6 L16.4,6.4 L13.6,9.2 L8.8,4.4 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Path Data="M8.1,5.1 L12.9,9.9 L7.4,15.4 C6.6,16.2 5.3,16.6 4.1,16.4 L1.6,16.9 L2.1,14.4 C1.9,13.2 2.3,11.9 3.1,11.1 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Canvas>
                            <TextBlock x:Name="PersonalizationLabel"
                                       Text="{DynamicResource Loc_Shell_Personalization}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Всплывающая панель персонализации -->
                <Popup x:Name="PersonalizationPopup"
                       PlacementTarget="{Binding ElementName=PersonalizationButton}"
                       Placement="Top"
                       VerticalOffset="-8"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       Opened="PersonalizationPopup_Opened">
                    <Border x:Name="PersonalizationCard"
                            Width="278"
                            Background="{DynamicResource PopupBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16"
                            Effect="{DynamicResource PopupShadowEffect}"
                            RenderTransformOrigin="0.5,1"
                            PreviewKeyDown="Window_PreviewKeyDown">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PersonalizationScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc_Shell_Personalization}" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="{DynamicResource Loc_Shell_PersonalizationTooltip}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,2,0,14" />

                            <TextBlock Text="{DynamicResource Loc_Popup_Theme}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <Border Background="{DynamicResource SegmentTrackBrush}"
                                    CornerRadius="9"
                                    Padding="3"
                                    Margin="0,6,0,0">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="LightThemeOption"
                                                 GroupName="ThemeOptions"
                                                 Style="{StaticResource SegmentRadio}"
                                                 Content="{DynamicResource Loc_Popup_Light}"
                                                 Checked="ThemeOption_Checked" />
                                    <RadioButton x:Name="DarkThemeOption"
                                                 GroupName="ThemeOptions"
                                                 Style="{StaticResource SegmentRadio}"
                                                 Content="{DynamicResource Loc_Popup_Dark}"
                                                 Checked="ThemeOption_Checked" />
                                </UniformGrid>
                            </Border>

                            <TextBlock Text="{DynamicResource Loc_Popup_Language}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,16,0,0" />
                            <Border Background="{DynamicResource SegmentTrackBrush}"
                                    CornerRadius="9"
                                    Padding="3"
                                    Margin="0,6,0,0">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="RuLanguageOption"
                                                 GroupName="LanguageOptions"
                                                 Style="{StaticResource SegmentRadio}"
                                                 Content="RU"
                                                 Checked="LanguageOption_Checked" />
                                    <RadioButton x:Name="EnLanguageOption"
                                                 GroupName="LanguageOptions"
                                                 Style="{StaticResource SegmentRadio}"
                                                 Content="EN"
                                                 Checked="LanguageOption_Checked" />
                                </UniformGrid>
                            </Border>

                            <TextBlock Text="{DynamicResource Loc_Popup_Scale}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,16,0,0" />
                            <Border Background="{DynamicResource SegmentTrackBrush}"
                                    CornerRadius="9"
                                    Padding="3"
                                    Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="−"
                                            Style="{StaticResource GhostButton}"
                                            FontSize="{DynamicResource FontSizeTitle}"
                                            ToolTip="{DynamicResource Loc_Popup_ZoomOutTooltip}"
                                            Click="ZoomOutButton_Click" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource GhostButton}"
                                            ToolTip="{DynamicResource Loc_Popup_ZoomResetTooltip}"
                                            Click="ZoomResetButton_Click">
                                        <TextBlock x:Name="ScalePercentText"
                                                   Text="100%"
                                                   FontFamily="{DynamicResource MonoFontFamily}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="2"
                                            Content="+"
                                            Style="{StaticResource GhostButton}"
                                            FontSize="{DynamicResource FontSizeTitle}"
                                            ToolTip="{DynamicResource Loc_Popup_ZoomInTooltip}"
                                            Click="ZoomInButton_Click" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{DynamicResource Loc_Popup_ScaleHint}"
                                       Style="{StaticResource KpiHintText}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- Рабочая область: вертикальный скролл появляется, только когда
             содержимое не влезает при сжатии окна или крупном масштабе.
             MinHeight по высоте вьюпорта: пока всё помещается, контент
             растягивается на всю высоту без прокрутки. -->
        <Grid Grid.Column="1" Margin="28,24,28,24">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitleText}" />
                        <TextBlock x:Name="PageSubtitleText"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <!-- Заглушка для разделов, которые ещё не подключены -->
                        <Border x:Name="PlaceholderPanel" Style="{StaticResource CardBorder}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                                <ContentControl Style="{StaticResource EasyKeepLogo}"
                                                Width="64" Height="64"
                                                HorizontalAlignment="Center" />
                                <TextBlock x:Name="PlaceholderTitle"
                                           Style="{StaticResource SectionTitleText}"
                                           HorizontalAlignment="Center"
                                           Margin="0,16,0,0" />
                                <TextBlock Text="{DynamicResource Loc_Shell_Placeholder}"
                                           Style="{StaticResource CaptionText}"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Новый экран: проявляется и мягко выезжает снизу. -->
                        <ContentControl x:Name="CurrentViewHost" Visibility="Collapsed">
                            <ContentControl.RenderTransform>
                                <TranslateTransform x:Name="ContentShift" Y="0" />
                            </ContentControl.RenderTransform>
                        </ContentControl>

                        <!-- Уходящий экран: лежит сверху и плавно растворяется. -->
                        <ContentControl x:Name="PreviousViewHost"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
