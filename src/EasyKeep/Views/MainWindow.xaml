<Window x:Class="EasyKeep.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyKeep — умный складской учёт"
        Height="800" Width="1280"
        MinHeight="640" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Боковое меню навигации -->
        <Border Grid.Column="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,22,16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource EasyKeepLogo}" Width="40" Height="40" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="EasyKeep"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Умный складской учёт"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Разделы -->
                <StackPanel Grid.Row="1" Margin="0,30,0,0">
                    <TextBlock Text="РАЗДЕЛЫ"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="14,0,0,8" />

                    <RadioButton x:Name="StocksNav"
                                 GroupName="Sections"
                                 Style="{StaticResource NavButton}"
                                 Tag="stocks"
                                 Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,20 H20 M6,20 V13 H9 V20 M11,20 V8 H14 V20 M16,20 V10 H19 V20"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="19" Height="19"
                                  Stretch="Uniform" />
                            <TextBlock Text="Остатки" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="MovementsNav"
                                 GroupName="Sections"
                                 Style="{StaticResource NavButton}"
                                 Tag="movements"
                                 Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,7 H16 M13,4 L17,7 L13,10 M20,17 H8 M11,14 L7,17 L11,20"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="19" Height="19"
                                  Stretch="Uniform" />
                            <TextBlock Text="Движения" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="CatalogNav"
                                 GroupName="Sections"
                                 Style="{StaticResource NavButton}"
                                 Tag="catalog"
                                 Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,7 L12,3 L20,7 V17 L12,21 L4,17 Z M4,7 L12,11 L20,7 M12,11 V21"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="19" Height="19"
                                  Stretch="Uniform" />
                            <TextBlock Text="Каталог" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ReportsNav"
                                 GroupName="Sections"
                                 Style="{StaticResource NavButton}"
                                 Tag="reports"
                                 Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,3 A9,9 0 1 0 21,12 H12 Z M12,3 V12 H21 A9,9 0 0 0 12,3"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  StrokeLineJoin="Round"
                                  Width="19" Height="19"
                                  Stretch="Uniform" />
                            <TextBlock Text="Отчёт" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Подвал меню -->
                <Border Grid.Row="3"
                        Background="{StaticResource AppBackgroundBrush}"
                        CornerRadius="8"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Локальная база данных"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="SQL Server • EasyKeep"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Рабочая область -->
        <Grid Grid.Column="1" Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitleText}" />
                <TextBlock x:Name="PageSubtitleText"
                           Style="{StaticResource CaptionText}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <!-- Заглушка для разделов, которые подключаются на следующих шагах -->
                <Border x:Name="PlaceholderPanel" Style="{StaticResource CardBorder}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                        <Image Source="{StaticResource EasyKeepLogo}"
                               Width="64" Height="64"
                               HorizontalAlignment="Center" />
                        <TextBlock x:Name="PlaceholderTitle"
                                   Style="{StaticResource SectionTitleText}"
                                   FontSize="17"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="Раздел будет подключён на следующем шаге разработки."
                                   Style="{StaticResource CaptionText}"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <ContentControl x:Name="ContentArea" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
